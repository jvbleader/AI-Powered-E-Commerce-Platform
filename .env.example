APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=mysql+asyncmy://<DB_USERNAME>:<DB_PASSWORD>@localhost:3306/ecommerce_db

ACCESS_TOKEN_SECRET=<ACCESS_TOKEN_SECRET>
ACCESS_TOKEN_TTL_MINUTES=1
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_HASH_PEPPER=<TOKEN_HASH_PEPPER>

EMAIL_VERIFYCATION_TOKEN_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

MAIL_FROM=no-reply@example.com
SMS_PROVIDER=mock

DEV_AUTH_DEBUG=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_APP_PASSWORD>
SMTP_FROM_EMAIL=<SMTP_FROM_EMAIL>
SMTP_FROM_NAME=Shepoo
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

API_KEY_OPENROUTER=xxx
BASE_URL_OPENROUTER=https://openrouter.ai/api/v1
MODEL_OPENROUTER=openrouter/free