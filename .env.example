# Copy: cp .env.example .env
# Used by Docker Compose (interpolation + shared env_file).
# Hostnames must match service names in docker-compose.*.yml.
# Compose builds DATABASE_URL / REDIS_URL / ELASTICSEARCH_URL from the blocks below.
# Dev first boot (docker-compose.dev.yml):
#   mysql (empty DB) -> db-migrate (create_all + stamp / upgrade) -> db-seed -> backend
# For compose.prod, change HOST_PORT values (e.g. 8001 / 3001 / 3308 / 9201).
# Use a MySQL password without @ # : / % to avoid breaking DATABASE_URL.

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ES_HOST=elasticsearch
ES_PORT=9200
ES_HOST_PORT=9200
ES_DISCOVERY_TYPE=single-node
ES_XPACK_SECURITY_ENABLED=false
ES_JAVA_OPTS=-Xms512m -Xmx512m

# -----------------------------------------------------------------------------
# Backend / Frontend ports
# -----------------------------------------------------------------------------
BACKEND_HOST=backend
BACKEND_PORT=8000
BACKEND_HOST_PORT=8000
FRONTEND_PORT=3000
FRONTEND_HOST_PORT=3000

# -----------------------------------------------------------------------------
# Frontend (browser / build args)
# NEXT_PUBLIC_API_BASE_URL is built in Compose from BACKEND_HOST_PORT.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_BASE_PATH=/auth
