ACCESS_TOKEN_SECRET=
TOKEN_HASH_PEPPER=

# Thông tin kết nối DB
DATABASE_URL=mysql+asyncmy://xxx:xxx@localhost:3306/ecommerce_db
MYSQL_USER=
MYSQL_PASSWORD=

# Base URL của Backend API để Frontend (Client) gọi đến
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


APP_ENV=development
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0

PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_TTL_MINUTES=5
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFYCATION_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL_VERIFY_TOKEN_TTL_HOURS=24

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

DEV_AUTH_DEBUG=true

# Cấu hình SMTP Gửi mail
MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shepoo
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Cấu hình LLM
API_KEY=
BASE_URL=https://api.groq.com/openai/v1
MODEL=qwen/qwen3.6-27b
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
