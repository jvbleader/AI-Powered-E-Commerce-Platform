# Copy: cp frontend/.env.example frontend/.env
# Frontend-only settings. In Docker, NEXT_PUBLIC_API_BASE_URL and
# INTERNAL_API_BASE_URL are set by Compose from the root .env.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Used when running frontend outside Docker (Compose overrides in containers)
INTERNAL_API_BASE_URL=http://backend:8000
