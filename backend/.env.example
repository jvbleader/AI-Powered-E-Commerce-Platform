# Copy: cp backend/.env.example backend/.env
# Backend-only settings. In Docker, Compose overrides DATABASE_URL / REDIS_URL /
# ELASTICSEARCH_URL / FRONTEND_URL / CORS_ORIGINS from the root .env.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
PYTHONPATH=/app/app:/app
INIT_DB_ON_START=false

# Local (non-Docker) defaults — Compose overrides these inside containers
DATABASE_URL=mysql+asyncmy://ecommerce_user:ecommerce_password@localhost:3307/ecommerce_db
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# Auth / cookies
# -----------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
TOKEN_HASH_PEPPER=dev-token-hash-pepper-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Used when running backend outside Docker (Compose overrides these in containers)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shepoo
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Tokens / OTP
# -----------------------------------------------------------------------------
EMAIL_VERIFYCATION_TOKEN_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
API_KEY=
BASE_URL=https://api.groq.com/openai/v1
MODEL=qwen/qwen3.6-27b

# -----------------------------------------------------------------------------
# Docker Desktop / WSL hot-reload
# -----------------------------------------------------------------------------
WATCHFILES_FORCE_POLLING=true
